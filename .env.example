# ==============================================================================
# Automated AI News Video Summarizer Configuration
# ==============================================================================

# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# YouTube Monitoring Configuration
# Example: UC_x5XG1OV2P6uZZ5FSM9Ttw (Google DeepMind)
YOUTUBE_CHANNEL_ID=UC_x5XG1OV2P6uZZ5FSM9Ttw

# GitHub Integration Configuration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repository_name
GITHUB_BRANCH=main

# Automation Tuning
MAX_VIDEOS_PER_RUN=3
MAX_CHUNK_SIZE=30000
LOG_LEVEL=INFO

# Set to true for local testing without uploading to GitHub or updating state
DRY_RUN=false
